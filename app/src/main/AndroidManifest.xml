<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 長押しすると、話しながら録音し、テキストに変換します。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- ユーザーは、バージョン情報ページで新しいバージョンをダウンロードした後、それをシステム インストーラーに送信して、オーバーレイのインストールを確認します。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- サンドボックスがインターネットに接続されているときに現在のネットワークの DNS サーバーを読み取ります -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Phone_set_alarm / Phone_set_timer: Android 標準インターフェイスを介して目覚まし時計とタイマーを設定するように時計アプリに依頼します (通常の権限、インストール後に利用可能) -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- 「再起動後の自動回復」: 起動時にワイヤレス デバッグを再度有効にします。この権限は通常のインストールでは取得できず、ユーザーがスイッチをオンにした後でのみ取得できます。
         ペアリングされた接続が許可されます。ここで宣言しなければ、許可すら得られません。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 会話ページの添付パネルの「最近の写真」: Android 13 以降は写真を読み取ることができ、Android 14 以降は一部の写真のみを提供でき、Android 12 以前は外部ストレージを読み取ることができます。
         はシステムのフォト セレクターとファイル セレクターを許可なく使用できます。カメラの許可なしにシステムカメラを使用して写真を撮る -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- ダイアログ ページの添付ファイルでは、(システム カメラを使用して) 写真を撮ることができます。カメラが使用されると記載されていますが、必須ではありません。カメラのないデバイスは通常どおりインストールできます。
         一部のシステムは、APK の特性に従ってアプリケーションを分類します。宣言されない場合、Mika はゲームとみなされ、リフレッシュ レートが制限される可能性があります。この声明は保持されるべきです。 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- 音声入力にはマイクが必要ですが、必須ではありません。マイクのないデバイスは通常通りインストールできますが、音声は使用できません -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- list_apps は、起動できるアプリのリストです。システム許可ボックスが配置されているパッケージを解析し、「カットアウェイ」を決定するために使用されます。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.content.pm.action.REQUEST_PERMISSIONS" />
        </intent>
        <!-- システムの処置: まず、時計またはカレンダーアプリが接続されているかどうかを確認し、接続されていない場合は、操作インターフェースに戻ります。 -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <!-- 音声入力: Android 11 以降ではこれが宣言されていないため、電話機の内蔵認識サービスを確認しても見つけることができません。 -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- ブート ページで、まずシステムで開発者向けオプション ページが開けるかどうかを確認します。開けない場合 (一部のオペレーティング環境には Android システム設定がありません)、最初は携帯電話の操作が使用できないことを意味します。 -->
        <intent>
            <action android:name="android.settings.APPLICATION_DEVELOPMENT_SETTINGS" />
        </intent>
        <!-- アカウント認証システムが配置されているパッケージ: デスクトップ アイコンのないシステム アカウント ログイン サービスも表示されている必要があり、そのログイン ページはホーム画面にポップアップ表示されるときにユーザーに委ねられます。 -->
        <intent>
            <action android:name="android.accounts.AccountAuthenticator" />
        </intent>
    </queries>

    <application
        android:name=".MikaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- にはインターフェイスが 1 つだけあります。デスクトップ、通知、他のアプリ、またはコマンドからインターフェイスを開くと、このインターフェイスに戻ります (新しく開いたインターフェイスは onNewIntent に渡されます)。上部に 2 番目のインターフェイスはありません。 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Mika"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".quit.CompleteStopActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar" />

        <!-- 通知内の引き継ぎボタンの配置ポイント: 通知からアクティビティが開始された場合にのみ通知バーが閉じられ、ユーザーはホーム画面に移動したアプリを直接確認できます。 -->
        <activity
            android:name=".takeover.TakeoverActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- アプリのファイル表示ページ (Web ページ、Markdown、PDF、画像、テキスト) -->
        <activity
            android:name=".ui.viewer.FileViewerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:exported="false"
            android:theme="@style/Theme.Mika" />

        <!-- Web ページの引き継ぎ: ユーザーが処理できるように、バックグラウンドの Web ページ タグ (同じ WebView) をメイン画面に取り込みます。 -->
        <activity
            android:name=".web.WebTakeoverActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!-- 互換性セルフテストのテスト ページは、Mika 仮想画面上で動作します。これは、組み込みアシスタント (シェル) がコンポーネント名によってミカの画面上で開くことができるようにのみ公開されています。
             呼び出し元は INTERACT_ACROSS_USERS_FULL を保持する必要があります。これはシェルでは使用できますが、通常のアプリでは使用できません。インテントフィルターはありません。単一のタスク。最近のタスクを入力しないでください -->
        <activity
            android:name=".selfcheck.SelfCheckTargetActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:windowSoftInputMode="stateHidden" />

        <service
            android:name=".a11y.MikaAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <service
            android:name=".task.TaskService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-requested phone task on the app's own virtual display and shows its progress; afterwards keeps the one web page the user asked to keep open running, for at most two hours" />
        </service>

        <!--
            コンピューター接続 (MCP): ユーザーが設定でこれをオンにするか、コンピューターが USB デバッグをオンにすると、バックグラウンドでリスニング ポートを開いたまま実行されます。オフにすると止まります。
            は、adb シェルが開始できるようにするためにのみ外部に開かれています (am start-foreground-service)。呼び出し元は INTERACT_ACROSS_USERS_FULL を保持する必要があります。
            シェルはありますが、通常のアプリでは取得できず、adb で教えることもできません。
        -->
        <service
            android:name=".mcp.McpService"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps user-enabled computer access available through a private-network or USB endpoint, or an outbound connection to the user's remote gateway, so authorized clients can hand tasks to the app" />
        </service>

        <!-- ChatGPT を使用したログイン中: ユーザーはブラウザーでのログイン時にプロセスを保持しており、誰もローカル コールバックに応答しません。ログインが完了するとすぐに停止します。 -->
        <service
            android:name=".settings.ChatGptSignInService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps sign-in alive while the user finishes account login in the external browser, for a loopback callback or device-code polling" />
        </service>

        <!-- はバックグラウンドで実行環境を準備し (APK に付属するルート ファイル システムのロックを解除します)、準備期間中にのみ実行されます。 -->
        <service
            android:name=".sandbox.SandboxService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Web ページのアップロード: 一時的に保存されたアップロード ファイルを、読み取り専用の content:// アドレスを使用して内蔵ブラウザのファイル選択ボックスに渡し、外部にはエクスポートしません。
             FileProvider には、grantUriPermissions=true が必要です。そうでない場合は、プロセスの開始時に例外がスローされます。
             このアドレスは他のアプリには決して許可されません。このプロセスにおける唯一のリーダーは WebView です。 -->
        <provider
            android:name=".web.WebFilesProvider"
            android:authorities="${applicationId}.webfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/web_files" />
        </provider>

        <!-- ダイアログ ページの添付ファイル: カメラは写真をカメラまたはキャッシュに書き込みます。送信された添付ファイルをクリックすると、コピーが表示されます。外部にエクスポートされることはなく、使用時に一時的に許可されます。 -->
        <provider
            android:name=".chat.AttachFilesProvider"
            android:authorities="${applicationId}.attachfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/attach_files" />
        </provider>

        <!-- ネットワーク プロキシ使用時にミカによってダウンロードされた更新インストール パッケージ: 読み取り専用でシステム インストーラーに渡され、外部にはエクスポートされず、インストール中に一時的に許可されます。 -->
        <provider
            android:name=".about.UpdateFilesProvider"
            android:authorities="${applicationId}.updatefiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_files" />
        </provider>

        <!-- ペアリング通知入力ボックスに入力されたペアリング コード -->
        <receiver
            android:name=".setup.PairingCodeReceiver"
            android:exported="false" />

        <receiver android:name=".payment.PaymentPauseReceiver" android:exported="false" />

        <!-- 組み込みアシスタント (シェル ID) ハンドオーバー バインダーの入り口: シェルにはこの権限がありますが、通常のアプリにはありません。
             入力後、発信者 UID、ワンタイム パスワード、APK を確認する必要があります。HelperHub.offer を参照してください。 -->
        <provider
            android:name=".shell.HelperHandoffProvider"
            android:authorities="${applicationId}.helper"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- ブート ブロードキャストはシステムによってのみ送信され (保護されたブロードキャスト)、必要に応じてエクスポートされます -->
        <receiver
            android:name=".setup.BootRestoreReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".task.TriggerAlarmReceiver" android:exported="false" />
    </application>

</manifest>
